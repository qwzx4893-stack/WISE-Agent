      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "python3 -c \"from web3 import Web3; w3 = Web3(Web3.HTTPProvider('{provider}')); {script}\"",
    "dependencies": [
      "python3",
      "web3"
    ],
    "timeout": 300,
    "source": "https://github.com/ethereum/web3.py"
