[
  {
    "name": "blockchain-developer",
    "version": "1.0.0",
    "description": "Blockchain Developer is a comprehensive toolkit for building, testing, and deploying smart contracts and decentralized applications across multiple blockchain networks including Ethereum, Solana, and Polygon.",
    "use_cases": [
      "Smart contract development",
      "dApp building",
      "Multi-chain deployment",
      "Web3 integration"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "description": "Development task description"
        },
        "network": {
          "type": "string",
          "description": "Target blockchain network",
          "default": "ethereum"
        }
      },
      "required": [
        "task"
      ]
    },
    "output_format": "Development output or deployment result.",
    "capabilities": [
      "blockchain",
      "smart contracts",
      "web3",
      "solidity",
      "dapps"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "blockchain-dev '{task}' --network {network}",
    "dependencies": [
      "nodejs",
      "npm",
      "truffle",
      "hardhat"
    ],
    "timeout": 600,
    "source": "https://github.com/blockchain/blockchain-developer"
  },
