  {
    "name": "busybox",
    "version": "1.36.0",
    "category": "Execution",
    "description": "Single-binary toolbox bundling tiny implementations of dozens of standard Unix utilities (sh, ls, cp, grep, tar, …) — useful inside the sandbox when full coreutils aren't installed.",
    "capabilities": [
      "list files",
      "copy/move files",
      "compress archives",
      "search text",
      "run minimal shell"
    ],
    "use_cases": [
      "Run common Unix utilities inside a minimal rootfs",
      "Recover from a broken /bin via a single binary"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "args": {
          "type": "string",
          "description": "BusyBox sub-command + args"
        }
      },
      "required": [
        "args"
      ]
    },
    "output_format": "Captured stdout/stderr from BusyBox.",
    "implementation_type": "cli",
    "cli_command": "busybox {args}",
    "cli_binary": "busybox",
    "dependencies": [
      "busybox-static"
    ],
    "timeout": 60,
    "security": {
      "requires_sandbox": true,
      "requires_network": false
    },
    "author": "BusyBox contributors",
    "source": "https://busybox.net/"
  },
