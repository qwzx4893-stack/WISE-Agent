[
  {
    "name": "echidna",
    "version": "1.0.0",
    "description": "Echidna is a Haskell-based fuzzer for Ethereum smart contracts. It uses property-based testing to find vulnerabilities by generating random sequences of transactions and checking user-defined invariants and assertions.",
    "use_cases": [
      "Smart contract fuzzing",
      "Property-based testing",
      "Invariant checking",
      "Ethereum security",
      "Vulnerability discovery"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "contract": {
          "type": "string",
          "description": "Path to Solidity contract file"
        },
        "test_limit": {
          "type": "integer",
          "description": "Number of test sequences",
          "default": 50000
        },
        "format": {
          "type": "string",
          "description": "Output format (text/json)",
          "default": "json"
        }
      },
      "required": [
        "contract"
      ]
    },
    "output_format": "Violated invariants and minimized call sequences.",
    "capabilities": [
      "fuzzing",
      "property-based testing",
      "smart contract",
      "ethereum",
      "invariants",
      "haskell"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": false,
      "memory_limit": "1G"
    },
    "implementation_type": "cli",
    "cli_command": "echidna {contract} --test-limit {test_limit} --format {format}",
    "dependencies": [
      "echidna",
      "solc",
      "haskell-stack"
    ],
    "timeout": 900,
    "author": "Trail of Bits",
    "source": "https://github.com/crytic/echidna"
  },
  {
    "name": "aderyn",
    "version": "1.0.0",
    "description": "Aderyn is a Rust-based Solidity static analyzer focused on detecting known vulnerability patterns and generating comprehensive security reports. It traverses the AST to identify high and medium severity issues in smart contracts.",
    "use_cases": [
      "Solidity static analysis",
      "Smart contract auditing",
      "Vulnerability detection",
      "AST analysis",
      "Security reporting"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "description": "Root directory containing Solidity files"
        },
        "output": {
          "type": "string",
          "description": "Output file path",
          "default": "report.md"
        },
        "format": {
          "type": "string",
          "description": "Output format (markdown/json)",
          "default": "markdown"
        }
      },
      "required": [
        "root"
      ]
    },
    "output_format": "Security report with detected vulnerabilities and locations.",
    "capabilities": [
      "static analysis",
      "solidity",
      "smart contract",
      "vulnerability",
      "AST",
      "rust"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": false
    },
    "implementation_type": "cli",
    "cli_command": "aderyn {root} -o {output} --format {format}",
    "dependencies": [
      "aderyn"
    ],
    "timeout": 300,
    "author": "Cyfrin",
    "source": "https://github.com/Cyfrin/aderyn"
  },
  {
    "name": "foundry",
    "version": "1.0.0",
    "description": "Foundry is a blazing fast, portable, and modular toolkit for Ethereum application development written in Rust. It includes Forge (testing), Cast (interaction), Anvil (local node), and Chisel (REPL) for comprehensive smart contract development.",
    "use_cases": [
      "Ethereum development",
      "Smart contract testing",
      "Local blockchain node",
      "Contract interaction",
      "Fuzzing"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "Foundry action (test/build/deploy/script/interact)"
        },
        "target": {
          "type": "string",
          "description": "Contract or script path"
        },
        "options": {
          "type": "string",
          "description": "Additional forge/cast options",
          "default": ""
        }
      },
      "required": [
        "action"
      ]
    },
    "output_format": "Test results, deployment info, or contract interaction output.",
    "capabilities": [
      "ethereum",
      "smart contract",
      "testing",
      "forge",
      "cast",
      "anvil",
      "rust"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true,
      "memory_limit": "512M"
    },
    "implementation_type": "cli",
    "cli_command": "forge {action} {target} {options} --json",
    "dependencies": [
      "foundry"
    ],
    "timeout": 600,
    "author": "Foundry",
    "source": "https://github.com/foundry-rs/foundry"
  },
  {
    "name": "solodit-mcp",
    "version": "1.0.0",
    "description": "Solodit is a Model Context Protocol (MCP) server that aggregates and searches smart contract audit reports from multiple sources including Code4rena, Sherlock, Spearbit, and Trail of Bits. It enables AI agents to query historical vulnerability findings.",
    "use_cases": [
      "Audit report search",
      "Vulnerability research",
      "Historical findings",
      "Smart contract security",
      "MCP integration"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query for vulnerabilities or contracts"
        },
        "source": {
          "type": "string",
          "description": "Audit source filter (c4/sherlock/all)",
          "default": "all"
        },
        "limit": {
          "type": "integer",
          "description": "Maximum results",
          "default": 10
        }
      },
      "required": [
        "query"
      ]
    },
    "output_format": "Relevant audit findings with source and context.",
    "capabilities": [
      "MCP",
      "audit",
      "smart contract",
      "vulnerability",
      "search",
      "knowledge"
    ],
    "category": "Memory",
    "security": {
      "requires_sandbox": false,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "solodit search '{query}' --source {source} --limit {limit}",
    "dependencies": [
      "solodit-mcp",
      "nodejs"
    ],
    "timeout": 60,
    "author": "Solodit",
    "source": "https://github.com/solodit/solodit-mcp"
  },
