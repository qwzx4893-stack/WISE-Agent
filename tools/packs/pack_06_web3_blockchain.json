  {
    "name": "gitleaks",
    "version": "1.0.0",
    "description": "Gitleaks is a SAST tool for detecting and preventing hardcoded secrets in git repositories. It scans commit history, branches, and working directory with over 100 detectors and provides pre-commit hook integration.",
    "use_cases": [
      "Git secret scanning",
      "Pre-commit security",
      "CI/CD secret detection",
      "Historical commit scanning",
      "Prevent credential leaks"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Repository path to scan"
        },
        "verbose": {
          "type": "boolean",
          "description": "Verbose output",
          "default": false
        },
        "redact": {
          "type": "boolean",
          "description": "Redact secrets in output",
          "default": true
        }
      },
      "required": [
        "path"
      ]
    },
    "output_format": "Detected secrets with file location and commit info.",
    "capabilities": [
      "secret scanning",
      "git",
      "pre-commit",
      "SAST",
      "credentials",
      "CI/CD"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": false
    },
    "implementation_type": "cli",
    "cli_command": "gitleaks detect --source {path} --report-format json --redact",
    "dependencies": [
      "gitleaks"
    ],
    "timeout": 600,
    "author": "Gitleaks",
    "source": "https://github.com/gitleaks/gitleaks"
  },
