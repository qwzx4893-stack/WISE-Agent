  {
    "name": "varlock",
    "version": "1.0.0",
    "description": "VarLock is a variable-level security scanner that detects hardcoded secrets, sensitive environment variables, and insecure default configurations in codebases and deployment manifests with minimal false positives.",
    "use_cases": [
      "Hardcoded secret detection",
      "Environment variable scanning",
      "Configuration security",
      "Pre-commit scanning",
      "CI/CD security"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Path to scan"
        },
        "severity": {
          "type": "string",
          "description": "Minimum severity (low/medium/high/critical)",
          "default": "medium"
        },
        "format": {
          "type": "string",
          "description": "Output format (json/text)",
          "default": "json"
        }
      },
      "required": [
        "path"
      ]
    },
    "output_format": "Detected secrets and sensitive configurations with severity.",
    "capabilities": [
      "secret scanning",
      "environment",
      "configuration",
      "security",
      "pre-commit",
      "CI/CD"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": false
    },
    "implementation_type": "cli",
    "cli_command": "varlock scan {path} --severity {severity} --format {format}",
    "dependencies": [
      "varlock",
      "python3"
    ],
    "timeout": 300,
    "author": "VarLock",
    "source": "https://github.com/varlock/varlock"
  },
