[
  {
    "name": "leon_speak",
    "version": "1.0.0",
    "description": "Speak text aloud using Leon AI speech synthesis (TTS) audio daemon.",
    "use_cases": [
      "announce task completion",
      "speak audible alerts to the user",
      "voice response"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "The message text to speak aloud."
        },
        "voice": {
          "type": "string",
          "description": "Voice profile or model name (default 'default')."
        },
        "lang": {
          "type": "string",
          "description": "Language code (e.g. 'en', 'ar', 'fr')."
        }
      },
      "required": [
        "text"
      ]
    },
    "category": "Assistant",
    "security": {
      "requires_sandbox": false,
      "requires_network": false
    },
    "implementation_type": "python",
    "capabilities": [
      "voice",
      "tts",
      "audio"
    ],
    "dependencies": []
  },
