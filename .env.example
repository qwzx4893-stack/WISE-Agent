# ==============================================================================
# WISE ECOSYSTEM UNIFIED CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Security Notice: API keys and credentials are kept isolated per subsystem:
# - Leon secrets reside in ~/.leon/profiles/<profile>/.env
# - Supergent secrets reside in Supergent keystore or environment variables
# ==============================================================================

# Environment
WISE_ENV=development
PYTHONIOENCODING=utf-8

# Network Endpoints
LEON_HTTP_HOST=127.0.0.1
LEON_HTTP_PORT=5366

LEON_AUDIO_HOST=127.0.0.1
LEON_AUDIO_PORT=5367

SUPERGENT_HOST=127.0.0.1
SUPERGENT_PORT=8765

WEB_APP_PORT=5173

# Optional: Bearer authentication tokens
# AGENT_API_TOKEN=your_supergent_admin_token
# LEON_PROFILE_TOKEN=your_leon_profile_token
