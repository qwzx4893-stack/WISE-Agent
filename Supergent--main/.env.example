# Local backend only. Never put this key in renderer, Git or localStorage.
# Configure provider OAuth apps and integrations in your Nango environment.
NANGO_SECRET_KEY=
NANGO_BASE_URL=https://api.nango.dev
# Only for trusted self-hosted HTTPS Connect/logo hosts; comma-separated origins.
# Cloud defaults already allow https://connect.nango.dev and https://app.nango.dev.
NANGO_CONNECT_ALLOWED_ORIGINS=
NANGO_LOGO_ALLOWED_ORIGINS=
# Optional: remove isolated scanners immediately instead of an hour-long idle cache.
WISE_SECURITY_TOOL_TTL_SECONDS=3600
