# Extensions connect directly through MCP. No broker environment key is needed.
# Service-specific credentials are entered in WISE's connection form / MCP import
# and stored locally with the existing protected secret store, never in Git.
# Optional OAuth CIMD support: use only an HTTPS metadata document deployed
# under your control. Without it WISE uses native DCR / registered public IDs.
# WISE_MCP_CLIENT_METADATA_URL=https://your-domain.example/wise-client.json
# Optional: remove isolated scanners immediately instead of an hour-long idle cache.
WISE_SECURITY_TOOL_TTL_SECONDS=3600
