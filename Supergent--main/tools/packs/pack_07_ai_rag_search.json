        },
        "fusion": {
          "type": "string",
          "description": "Fusion method (rrf/weighted/round_robin)",
          "default": "rrf"
        },
        "limit": {
          "type": "integer",
          "description": "Maximum results",
          "default": 10
        }
      },
      "required": [
