[
  {
    "name": "openai",
    "version": "1.0.0",
    "description": "OpenAI API client for accessing GPT-4, GPT-3.5, and other OpenAI models. Provides function calling, embeddings, vision, and audio capabilities with official Python library support.",
    "use_cases": [
      "LLM access",
      "Text generation",
      "Function calling",
      "Embeddings creation",
      "Vision analysis"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "description": "Model name (gpt-4/gpt-3.5-turbo)",
          "default": "gpt-4"
        },
        "prompt": {
          "type": "string",
          "description": "User prompt"
        },
        "system": {
          "type": "string",
          "description": "System message",
          "default": ""
        },
        "temperature": {
          "type": "number",
          "description": "Temperature (0-2)",
          "default": 0.7
        }
      },
      "required": [
        "prompt"
      ]
    },
    "output_format": "LLM response text or structured output.",
    "capabilities": [
      "LLM",
      "OpenAI",
      "GPT",
      "embeddings",
      "function calling",
      "vision"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "openai api chat.completions.create -m {model} -g user '{prompt}' --temperature {temperature}",
    "dependencies": [
      "openai",
      "python3"
    ],
    "timeout": 120,
    "author": "OpenAI",
    "source": "https://github.com/openai/openai-python"
  },
  {
