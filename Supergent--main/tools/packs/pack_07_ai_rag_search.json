  {
    "name": "firecrawl-scraper",
    "version": "1.0.0",
    "description": "Firecrawl is an advanced web scraping and crawling tool that converts websites into LLM-ready markdown or structured data. It handles JavaScript rendering, pagination, and provides clean, extracted content.",
    "use_cases": [
      "Web scraping",
      "LLM data preparation",
      "Markdown extraction",
      "Site crawling",
      "Data extraction"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "Starting URL to scrape"
        },
        "mode": {
          "type": "string",
          "description": "Mode (scrape/crawl/map)",
          "default": "scrape"
        },
        "format": {
          "type": "string",
          "description": "Output format (markdown/json/html)",
          "default": "markdown"
        },
        "limit": {
          "type": "integer",
          "description": "Max pages (crawl mode)",
          "default": 10
        }
      },
      "required": [
        "url"
      ]
    },
    "output_format": "Scraped content in requested format.",
    "capabilities": [
      "scraping",
      "crawling",
      "markdown",
      "LLM-ready",
      "javascript",
      "extraction"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true,
      "memory_limit": "512M"
    },
    "implementation_type": "cli",
    "cli_command": "firecrawl {mode} '{url}' --format {format} --limit {limit}",
    "dependencies": [
      "firecrawl",
      "nodejs"
    ],
    "timeout": 300,
    "author": "Firecrawl",
    "source": "https://github.com/mendableai/firecrawl"
  },
