  {
    "name": "dbt-transformation-patterns",
    "version": "1.0.0",
    "description": "DBT Transformation Patterns provides reusable dbt models, macros, and patterns for data transformation pipelines. It includes incremental loading, snapshotting, testing, and documentation generation.",
    "use_cases": [
      "Data transformation",
      "Analytics engineering",
      "ETL pipelines",
      "Data modeling",
      "Data testing"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "DBT action (run/test/docs/compile)"
        },
        "models": {
          "type": "string",
          "description": "Model selection pattern",
          "default": "+*"
        },
        "profile": {
          "type": "string",
          "description": "DBT profile name",
          "default": "default"
        }
      },
      "required": [
        "action"
      ]
    },
    "output_format": "DBT execution output with test results.",
    "capabilities": [
      "dbt",
      "transformation",
      "analytics",
      "data modeling",
      "sql"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "dbt {action} --select {models} --profile {profile}",
    "dependencies": [
      "python3",
      "dbt-core"
    ],
    "timeout": 600,
    "source": "https://github.com/dbt-labs/dbt-core",
    "replaces": "1.0.0"
