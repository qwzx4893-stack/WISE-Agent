[
  {
    "name": "data-scientist",
    "version": "1.0.0",
    "description": "Data Scientist is a comprehensive toolkit for end-to-end data science workflows including data cleaning, exploratory analysis, feature engineering, model selection, and visualization.",
    "use_cases": [
      "Data analysis",
      "Machine learning",
      "Statistical modeling",
      "Feature engineering",
      "Data visualization"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "description": "Data science task description"
        },
        "data": {
          "type": "string",
          "description": "Path to dataset file"
        },
        "config": {
          "type": "string",
          "description": "Configuration JSON",
          "default": "{}"
        }
      },
      "required": [
        "task",
        "data"
      ]
    },
    "output_format": "Analysis results, model metrics, and visualizations.",
    "capabilities": [
      "data science",
      "machine learning",
      "statistics",
      "visualization",
      "analysis"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": false,
      "memory_limit": "1G"
    },
    "implementation_type": "cli",
    "cli_command": "data-scientist analyze '{task}' --data {data} --config '{config}'",
    "dependencies": [
      "python3",
      "pandas",
      "numpy",
      "scikit-learn",
      "matplotlib"
    ],
    "timeout": 600,
    "source": "https://github.com/datascientist/toolkit",
    "replaces": "1.0.0"
  },
  {
    "name": "polars",
    "version": "1.0.0",
    "description": "Polars is a lightning-fast DataFrame library for Rust and Python, designed for high-performance data manipulation. It provides lazy evaluation, vectorized operations, and memory-efficient processing.",
    "use_cases": [
      "Large dataset processing",
      "ETL pipelines",
      "Data transformation",
      "Performance-critical analytics",
      "Memory-efficient operations"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "script": {
          "type": "string",
          "description": "Python code using polars"
        },
        "input": {
          "type": "string",
          "description": "Input data file path",
          "default": ""
        }
      },
      "required": [
        "script"
      ]
    },
    "output_format": "DataFrame output or computation result.",
    "capabilities": [
      "dataframe",
      "rust",
      "performance",
      "etl",
      "analytics"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": false,
      "memory_limit": "2G"
    },
    "implementation_type": "cli",
    "cli_command": "python3 -c \"import polars as pl; {script}\"",
    "dependencies": [
      "python3",
      "polars"
    ],
    "timeout": 300,
    "source": "https://github.com/pola-rs/polars",
    "replaces": "1.0.0"
  },
