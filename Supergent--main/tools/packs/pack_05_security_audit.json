          "type": "string",
          "description": "Contract address or file path"
        },
        "execution_timeout": {
          "type": "integer",
          "description": "Symbolic execution timeout (seconds)",
          "default": 120
        },
        "format": {
          "type": "string",
          "description": "Output format (json/text)",
          "default": "json"
        }
      },
      "required": [
        "target"
      ]
    },
