  {
    "name": "slither",
    "version": "1.0.0",
    "description": "Slither is a Solidity static analysis framework written in Python. It detects vulnerabilities, optimizes gas usage, and provides code understanding capabilities for Ethereum smart contracts with 100+ built-in detectors.",
    "use_cases": [
      "Smart contract security",
      "Solidity analysis",
      "Vulnerability detection",
      "Gas optimization",
      "Code understanding"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Path to Solidity file or directory"
        },
        "detectors": {
          "type": "string",
          "description": "Detectors to run (all/medium/high)",
          "default": "all"
        },
        "format": {
          "type": "string",
          "description": "Output format (json/text/sarif)",
          "default": "json"
        }
      },
      "required": [
        "path"
      ]
    },
    "output_format": "Vulnerability findings with severity and location.",
    "capabilities": [
      "solidity",
      "static analysis",
      "smart contract",
      "ethereum",
      "vulnerability",
      "gas optimization"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": false
    },
    "implementation_type": "cli",
    "cli_command": "slither {path} --detect {detectors} --{format} -",
    "dependencies": [
      "slither-analyzer",
      "python3",
      "solc"
    ],
    "timeout": 600,
    "author": "Trail of Bits",
    "source": "https://github.com/crytic/slither"
  },
  {
    "name": "mythril",
    "version": "1.0.0",
