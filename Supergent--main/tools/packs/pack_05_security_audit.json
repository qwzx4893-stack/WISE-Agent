    "security": {
      "requires_sandbox": true,
      "requires_network": true,
      "memory_limit": "1G"
    },
    "implementation_type": "cli",
    "cli_command": "myth analyze {target} --execution-timeout {execution_timeout} --{format}",
    "dependencies": [
      "mythril",
      "python3",
      "solc"
