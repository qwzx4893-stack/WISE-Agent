[
  {
    "name": "metasploit-framework",
    "version": "1.0.0",
    "description": "Metasploit Framework is the world's most used penetration testing framework. It provides exploit development, payload generation, post-exploitation modules, and comprehensive vulnerability validation capabilities for security professionals.",
    "use_cases": [
      "Penetration testing",
      "Exploit development",
      "Vulnerability validation",
      "Post-exploitation",
      "Payload generation"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "Action (scan/exploit/payload/session/list)"
        },
        "target": {
          "type": "string",
          "description": "Target IP, URL, or range"
        },
        "module": {
          "type": "string",
          "description": "Module to use",
          "default": ""
        }
      },
      "required": [
        "action"
      ]
    },
    "output_format": "Exploit results, session info, or scan findings.",
    "capabilities": [
      "penetration testing",
      "exploit",
      "payload",
      "post-exploitation",
      "vulnerability",
      "security"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true,
      "memory_limit": "1G"
    },
    "implementation_type": "cli",
    "cli_command": "msfconsole -q -x '{action} {target} {module}; exit'",
    "dependencies": [
      "metasploit-framework"
    ],
    "timeout": 1800,
    "author": "Rapid7",
    "source": "https://github.com/rapid7/metasploit-framework"
  },
  {
    "name": "dast-ffuf",
    "version": "1.0.0",
    "description": "ffuf is a fast web fuzzer written in Go. It excels at directory discovery, virtual host enumeration, parameter fuzzing, and API endpoint discovery with high performance and low resource usage.",
    "use_cases": [
      "Directory fuzzing",
      "Virtual host discovery",
      "Parameter fuzzing",
      "API endpoint enumeration",
      "Content discovery"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "Target URL with FUZZ keyword"
        },
        "wordlist": {
          "type": "string",
          "description": "Path to wordlist",
          "default": "/usr/share/wordlists/dirb/common.txt"
        },
        "options": {
          "type": "string",
          "description": "Additional ffuf options",
          "default": "-c -t 50"
        }
      },
      "required": [
        "url"
      ]
    },
    "output_format": "Discovered paths, status codes, and response sizes.",
    "capabilities": [
      "fuzzing",
      "directory discovery",
      "web",
      "enumeration",
      "DAST",
      "fast"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "ffuf -u '{url}' -w {wordlist} {options} -of json",
    "dependencies": [
      "ffuf"
    ],
    "timeout": 600,
    "author": "ffuf",
    "source": "https://github.com/ffuf/ffuf"
  },
  {
    "name": "snyk",
    "version": "1.0.0",
    "description": "Snyk is a developer-first security platform that finds and fixes vulnerabilities in code, open source dependencies, containers, and infrastructure as code. It provides actionable remediation advice and automated fix PRs.",
    "use_cases": [
      "Open source vulnerability scanning",
      "Container security",
      "IaC security",
      "Code security analysis",
      "License compliance"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Path to scan"
        },
        "type": {
          "type": "string",
          "description": "Scan type (code/container/iac/all)",
          "default": "all"
        },
        "severity": {
          "type": "string",
          "description": "Minimum severity threshold",
          "default": "low"
        }
      },
      "required": [
        "path"
      ]
    },
    "output_format": "Vulnerability report with fix recommendations.",
    "capabilities": [
      "vulnerability scanner",
      "open source",
      "containers",
      "IaC",
      "SCA",
      "remediation"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "snyk test {path} --severity-threshold={severity} --json",
    "dependencies": [
      "snyk",
      "nodejs"
    ],
    "timeout": 600,
    "author": "Snyk",
    "source": "https://github.com/snyk/cli"
  },
  {
    "name": "trufflehog",
    "version": "1.0.0",
    "description": "TruffleHog is a powerful secrets scanner that finds and verifies leaked credentials across git repositories, S3 buckets, filesystems, and chat logs. It uses over 800 detectors with verification to eliminate false positives.",
    "use_cases": [
      "Secret scanning",
      "Credential leak detection",
      "Git history scanning",
      "API key detection",
      "Password auditing"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "description": "Target (git URL, path, or S3 bucket)"
        },
        "verify": {
          "type": "boolean",
          "description": "Verify detected secrets",
          "default": true
        },
        "depth": {
          "type": "integer",
          "description": "Git history depth",
          "default": 0
        }
      },
      "required": [
        "target"
      ]
    },
    "output_format": "Detected secrets with verification status.",
    "capabilities": [
      "secret scanning",
      "credentials",
      "git",
      "API keys",
      "verification",
      "security"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "trufflehog filesystem {target} --json --no-update",
    "dependencies": [
      "trufflehog"
    ],
    "timeout": 600,
    "author": "Truffle Security",
    "source": "https://github.com/trufflesecurity/trufflehog"
  },
