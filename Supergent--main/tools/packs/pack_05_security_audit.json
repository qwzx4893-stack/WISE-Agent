  {
    "name": "medusa",
    "version": "1.0.0",
    "description": "Medusa is a parallel, coverage-guided smart contract fuzzing tool written in Go. It tests the security of Ethereum smart contracts by generating and executing random transactions to find vulnerabilities and edge cases.",
    "use_cases": [
      "Smart contract fuzzing",
      "Coverage-guided testing",
      "Ethereum security",
      "Vulnerability discovery",
      "Property testing"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "description": "Contract address or file path"
        },
        "timeout": {
          "type": "integer",
          "description": "Fuzzing duration (seconds)",
          "default": 300
        },
        "workers": {
          "type": "integer",
          "description": "Number of parallel workers",
          "default": 4
        }
      },
      "required": [
        "target"
      ]
    },
    "output_format": "Discovered vulnerabilities and coverage report.",
    "capabilities": [
      "fuzzing",
      "smart contract",
      "coverage-guided",
      "ethereum",
      "vulnerability",
      "go"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true,
      "memory_limit": "512M"
    },
    "implementation_type": "cli",
    "cli_command": "medusa fuzz --target {target} --timeout {timeout} --workers {workers}",
    "dependencies": [
      "medusa-fuzz"
    ],
    "timeout": 600,
    "author": "Crytic",
    "source": "https://github.com/crytic/medusa"
  }
