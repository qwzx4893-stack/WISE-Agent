[
  {
    "name": "webtoapp",
    "version": "1.0.0",
    "description": "WebToApp is a comprehensive toolkit for converting websites into native mobile applications. It provides wrapper generation, native feature integration, push notification setup, and app store deployment automation.",
    "use_cases": [
      "Website to app conversion",
      "PWA to native",
      "Mobile app wrapper",
      "Native feature integration",
      "App store publishing"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "Website URL to convert"
        },
        "platform": {
          "type": "string",
          "description": "Target platform (android/ios/both)",
          "default": "both"
        },
        "features": {
          "type": "string",
          "description": "Native features (push/camera/location)",
          "default": "push"
        }
      },
      "required": [
        "url"
      ]
    },
    "output_format": "Generated mobile app project or build files.",
    "capabilities": [
      "mobile",
      "conversion",
      "PWA",
      "WebView",
      "native",
      "app store",
      "wrapper"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "webtoapp convert '{url}' --platform {platform} --features {features}",
    "dependencies": [
      "webtoapp",
      "nodejs",
      "cordova"
    ],
    "timeout": 600,
    "author": "WebToApp",
    "source": "https://github.com/webtoapp/webtoapp"
  },
  {
    "name": "expo-deployment",
    "version": "1.0.0",
    "description": "Expo Deployment is an expert agent for building, deploying, and managing React Native applications with Expo. It provides EAS Build configuration, OTA updates, app store submissions, and production optimization strategies.",
    "use_cases": [
      "Expo app deployment",
      "EAS Build",
      "OTA updates",
      "App Store submission",
      "React Native production"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "Action (build/submit/update/publish)"
        },
        "platform": {
          "type": "string",
          "description": "Platform (ios/android/all)",
          "default": "all"
        },
        "profile": {
          "type": "string",
          "description": "Build profile",
          "default": "production"
        }
      },
      "required": [
        "action"
      ]
    },
    "output_format": "Build or deployment result with URLs.",
    "capabilities": [
      "expo",
      "react-native",
      "deployment",
      "EAS",
      "OTA",
      "app store",
      "mobile",
      "CI/CD"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "eas {action} --platform {platform} --profile {profile}",
    "dependencies": [
      "expo-cli",
      "eas-cli",
      "nodejs"
    ],
    "timeout": 1200,
    "author": "Expo",
    "source": "https://github.com/expo/eas-cli"
  },
  {
    "name": "postgresql",
    "version": "1.0.0",
    "description": "PostgreSQL Expert is an AI agent specialized in PostgreSQL database design, optimization, and administration. It provides query optimization, schema design, indexing strategies, and performance tuning for production databases.",
    "use_cases": [
      "Database design",
      "Query optimization",
      "Schema migration",
      "Indexing strategy",
      "Performance tuning"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "SQL query or database task"
        },
        "action": {
          "type": "string",
          "description": "Action (optimize/design/explain/migrate)",
          "default": "optimize"
        }
      },
      "required": [
        "query"
      ]
    },
    "output_format": "Optimized query, schema, or recommendations.",
    "capabilities": [
      "postgresql",
      "SQL",
      "database",
      "optimization",
      "indexing",
      "schema",
      "performance"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "python3 -c 'import psycopg2; print(\"PostgreSQL expert analysis\")' && psql -c '{query}'",
    "dependencies": [
      "postgresql",
      "python3",
      "psycopg2"
    ],
    "timeout": 300,
    "author": "PostgreSQL",
    "source": "https://github.com/postgres/postgres"
  },
  {
    "name": "redis",
    "version": "1.0.0",
    "description": "Redis Expert is an AI agent specialized in Redis data structure design, caching strategies, and performance optimization. It provides guidance on data modeling, eviction policies, persistence configuration, and high-availability setups.",
