      "Redis caching",
      "Data structure design",
      "Performance optimization",
      "Pub/Sub patterns",
      "Rate limiting"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "description": "Redis task or data structure description"
        },
        "action": {
          "type": "string",
          "description": "Action (design/optimize/command/cluster)",
          "default": "design"
        }
      },
      "required": [
        "task"
      ]
    },
    "output_format": "Redis commands, configuration, or recommendations.",
    "capabilities": [
      "redis",
      "caching",
      "data structures",
      "performance",
      "Pub/Sub",
      "NoSQL",
      "in-memory"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "redis-cli INFO && python3 -c 'import redis; r = redis.Redis(); print(r.ping())'",
    "dependencies": [
      "redis",
      "redis-tools",
      "python3",
      "redis-py"
    ],
    "timeout": 180,
    "author": "Redis",
    "source": "https://github.com/redis/redis"
  },
  {
    "name": "prisma-expert",
