    "use_cases": [
      "Deployment strategy design",
      "CI/CD pipeline architecture",
      "Blue-green deployment",
      "Canary releases",
      "Infrastructure planning"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "application": {
          "type": "string",
          "description": "Application architecture description"
        },
        "requirements": {
          "type": "string",
          "description": "Deployment requirements"
        },
        "platform": {
          "type": "string",
          "description": "Target platform (aws/gcp/azure/k8s)",
          "default": "auto"
        }
      },
      "required": [
        "application"
      ]
    },
    "output_format": "Deployment pipeline design document with recommendations.",
    "capabilities": [
      "deployment",
      "CI/CD",
      "pipeline",
      "blue-green",
      "canary",
      "infrastructure",
      "architecture"
    ],
    "category": "Planning",
    "security": {
      "requires_sandbox": false,
      "requires_network": false
    },
    "implementation_type": "python",
    "timeout": 180,
    "author": "Deploy AI",
    "source": "https://github.com/deploy-ai/deployment-pipeline-design",
    "dependencies": []
  },
  {
    "name": "semgrep",
    "version": "1.0.0",
    "description": "Semgrep is a fast, open-source static analysis tool for finding bugs, detecting security vulnerabilities, and enforcing code standards. It supports 30+ languages and provides custom rule creation with simple pattern matching.",
    "use_cases": [
      "Static code analysis",
      "Security vulnerability detection",
      "Code quality enforcement",
      "Custom rule scanning",
      "CI/CD security integration"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Path to scan"
        },
        "config": {
          "type": "string",
          "description": "Ruleset or config (auto/p/ci/security)",
          "default": "auto"
        },
        "output_format": {
          "type": "string",
          "description": "Output format (text/json/sarif)",
          "default": "json"
        }
      },
      "required": [
        "path"
      ]
    },
    "output_format": "Scan results with findings and remediation guidance.",
    "capabilities": [
      "static analysis",
      "security",
      "SAST",
      "code quality",
      "vulnerability",
      "linting"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "semgrep scan --config {config} --{output_format} {path}",
    "dependencies": [
      "semgrep",
      "python3"
    ],
    "timeout": 600,
    "author": "Semgrep",
    "source": "https://github.com/semgrep/semgrep"
  },
  {
    "name": "nuclei",
    "version": "1.0.0",
    "description": "Nuclei is a fast, template-based vulnerability scanner for web applications, networks, and cloud infrastructure. It uses YAML-based templates to detect misconfigurations, CVEs, and security issues with minimal false positives.",
    "use_cases": [
      "Vulnerability scanning",
      "Security assessment",
      "Misconfiguration detection",
      "CVE scanning",
      "Penetration testing"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "description": "Target URL, IP, or file"
        },
        "templates": {
          "type": "string",
          "description": "Template selection (all/cves/misconfig/tech)",
          "default": "all"
        },
        "severity": {
          "type": "string",
          "description": "Minimum severity (info/low/medium/high/critical)",
          "default": "low"
        }
      },
      "required": [
        "target"
      ]
    },
    "output_format": "Vulnerability findings with severity and remediation.",
    "capabilities": [
      "vulnerability scanner",
      "security",
      "CVE",
      "misconfiguration",
      "template-based",
      "DAST"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true,
      "memory_limit": "512M"
    },
    "implementation_type": "cli",
    "cli_command": "nuclei -u {target} -t {templates} -severity {severity} -json",
    "dependencies": [
      "nuclei"
    ],
    "timeout": 600,
    "author": "ProjectDiscovery",
    "source": "https://github.com/projectdiscovery/nuclei"
  },
