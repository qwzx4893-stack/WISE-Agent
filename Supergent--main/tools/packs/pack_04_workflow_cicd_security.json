[
  {
    "name": "n8n",
    "version": "1.0.0",
    "description": "n8n is a fair-code workflow automation platform with native AI capabilities. It enables building complex multi-step workflows connecting hundreds of apps and services, with self-hosted deployment for complete data privacy.",
    "use_cases": [
      "Workflow automation",
      "Multi-service integration",
      "AI agent workflows",
      "Data pipeline automation",
      "Self-hosted automation"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "workflow": {
          "type": "string",
          "description": "Workflow definition JSON"
        },
        "action": {
          "type": "string",
          "description": "Action (run/list/activate/deactivate)",
          "default": "run"
        }
      },
      "required": [
        "workflow"
      ]
    },
    "output_format": "Workflow execution results or status.",
    "capabilities": [
      "workflow",
      "automation",
      "integration",
      "no-code",
      "self-hosted",
      "fair-code"
    ],
    "category": "Orchestration",
    "security": {
      "requires_sandbox": true,
      "requires_network": true,
      "memory_limit": "512M"
    },
    "implementation_type": "cli",
    "cli_command": "n8n execute --workflow '{workflow}'",
    "dependencies": [
      "n8n",
      "nodejs"
    ],
    "timeout": 600,
    "author": "n8n",
    "source": "https://github.com/n8n-io/n8n"
  },
  {
    "name": "temporal",
    "version": "1.0.0",
    "description": "Temporal is a durable execution platform for building resilient distributed applications. It guarantees workflow completion even through failures, with automatic retries, state persistence, and exactly-once execution semantics.",
    "use_cases": [
      "Durable workflows",
      "Distributed systems",
      "Fault-tolerant execution",
      "Long-running processes",
      "Saga pattern implementation"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "workflow_type": {
          "type": "string",
          "description": "Type of workflow to execute"
        },
        "input": {
          "type": "string",
          "description": "Workflow input JSON"
        },
        "task_queue": {
          "type": "string",
          "description": "Task queue name",
          "default": "default"
        }
      },
      "required": [
        "workflow_type",
        "input"
      ]
    },
    "output_format": "Workflow execution result with run ID.",
    "capabilities": [
      "durable execution",
      "workflow",
      "distributed",
      "fault-tolerant",
      "retries",
      "persistence"
    ],
    "category": "Orchestration",
    "security": {
      "requires_sandbox": true,
      "requires_network": true,
      "memory_limit": "512M"
    },
    "implementation_type": "cli",
    "cli_command": "temporal workflow execute --type {workflow_type} --input '{input}' --task-queue {task_queue}",
    "dependencies": [
      "temporal",
      "temporal-cli"
    ],
    "timeout": 3600,
    "author": "Temporal Technologies",
    "source": "https://github.com/temporalio/temporal"
  },
  {
    "name": "bullmq",
    "version": "1.0.0",
    "description": "BullMQ is a fast, robust, and scalable job queue and message queue system for Node.js, backed by Redis. It supports delayed jobs, retries, priorities, concurrency control, and reliable message processing with exactly-once semantics.",
    "use_cases": [
      "Job queue management",
      "Background task processing",
      "Message queuing",
      "Delayed execution",
      "Priority queues"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "Queue action (add/process/pause/resume/clean)"
        },
        "queue_name": {
          "type": "string",
          "description": "Name of the queue"
        },
        "data": {
          "type": "string",
          "description": "Job data JSON",
          "default": "{}"
        },
        "options": {
          "type": "string",
          "description": "Job options JSON",
          "default": "{}"
        }
      },
      "required": [
        "action",
        "queue_name"
      ]
    },
    "output_format": "Job ID or queue status.",
    "capabilities": [
      "queue",
      "job",
      "redis",
      "background",
      "priority",
      "concurrency",
      "exactly-once"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "bullmq-cli {action} --queue {queue_name} --data '{data}' --options '{options}'",
    "dependencies": [
      "bullmq",
      "nodejs",
      "redis"
    ],
    "timeout": 300,
    "author": "Taskforce.sh",
    "source": "https://github.com/taskforcesh/bullmq"
  },
  {
    "name": "inngest",
    "version": "1.0.0",
    "description": "Inngest is a durable workflow and event-driven platform for building reliable serverless applications. It handles queuing, retries, state management, and step functions with automatic observability and zero infrastructure management.",
    "use_cases": [
      "Serverless workflows",
      "Event-driven architecture",
      "Durable functions",
      "Step functions",
      "Background job processing"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "description": "Event name or trigger"
        },
        "data": {
          "type": "string",
          "description": "Event data JSON"
        },
        "user_id": {
          "type": "string",
          "description": "User identifier for idempotency",
          "default": ""
        }
      },
      "required": [
        "event",
        "data"
      ]
    },
    "output_format": "Event processing result with run ID.",
    "capabilities": [
      "durable workflow",
      "serverless",
      "event-driven",
      "retries",
      "state management",
      "observability"
    ],
    "category": "Orchestration",
    "security": {
      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "inngest send --event {event} --data '{data}'",
    "dependencies": [
      "inngest-cli",
      "nodejs"
    ],
    "timeout": 600,
    "author": "Inngest",
    "source": "https://github.com/inngest/inngest"
  },
  {
    "name": "github-actions-generator",
    "version": "1.0.0",
    "description": "An AI-powered tool that generates optimized GitHub Actions workflow files from natural language descriptions. It understands CI/CD requirements and produces production-ready YAML configurations with best practices.",
    "use_cases": [
      "CI/CD automation",
      "GitHub Actions creation",
      "Workflow generation",
      "DevOps automation",
      "Pipeline configuration"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "description": "Natural language description of the workflow"
        },
        "triggers": {
          "type": "string",
          "description": "Event triggers (push/pull_request/schedule)",
          "default": "push"
        },
        "environment": {
          "type": "string",
          "description": "Target environment",
          "default": "ubuntu-latest"
        }
      },
      "required": [
        "description"
      ]
    },
    "output_format": "Complete GitHub Actions workflow YAML file.",
    "capabilities": [
      "github actions",
      "CI/CD",
      "workflow",
      "automation",
      "YAML",
      "DevOps"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "gh-actions-gen '{description}' --triggers {triggers} --env {environment}",
    "dependencies": [
      "github-actions-generator",
      "nodejs"
    ],
    "timeout": 120,
    "author": "Actions Generator",
    "source": "https://github.com/actions-generator/github-actions-generator"
  },
  {
    "name": "github-automation",
    "version": "1.0.0",
    "description": "A comprehensive GitHub automation toolkit for AI agents. It provides APIs for repository management, issue tracking, PR handling, release automation, and GitHub API interactions with built-in rate limiting and pagination.",
    "use_cases": [
      "Repository automation",
      "Issue management",
      "PR workflows",
      "Release automation",
      "GitHub API integration"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "GitHub action (create-issue/create-pr/list-repos/get-workflow)"
        },
        "params": {
          "type": "string",
          "description": "Action parameters JSON"
        }
      },
      "required": [
        "action"
      ]
    },
    "output_format": "GitHub API response or confirmation.",
    "capabilities": [
      "github",
      "automation",
      "API",
      "repositories",
      "issues",
      "pull requests",
      "releases"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "github-automation {action} '{params}'",
    "dependencies": [
      "github-automation",
      "python3",
      "gh"
    ],
    "timeout": 120,
    "author": "GitHub Automation",
    "source": "https://github.com/github-automation/github-automation"
  },
  {
    "name": "deployment-pipeline-design",
    "version": "1.0.0",
