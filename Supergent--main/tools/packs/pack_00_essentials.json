  {
    "name": "execute_python",
    "version": "1.0.0",
    "description": "Executes a Python script in a sandboxed environment and returns the output.",
    "use_cases": [
      "Data processing",
      "Automation",
      "Calculations",
      "Prototyping"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
