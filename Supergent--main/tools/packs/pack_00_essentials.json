  {
    "name": "web_search",
    "version": "1.0.0",
    "description": "Searches the web using DuckDuckGo and returns result snippets.",
    "use_cases": [
      "Finding current information",
      "Research",
      "Fact-checking"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query"
        }
      },
      "required": [
        "query"
      ]
    },
    "output_format": "Newline-separated search result snippets.",
    "capabilities": [
      "web",
      "search",
      "information retrieval"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "curl -s -L -A 'Mozilla/5.0' 'https://html.duckduckgo.com/html/?q={query}' | grep -oP '(?<=result__a\">).*?(?=</a>)' | head -10",
    "dependencies": [
      "curl"
    ],
    "timeout": 30
  },
  {
