      ]
    },
    "output_format": "Standard output and error from the Python interpreter.",
    "capabilities": [
      "code execution",
      "python",
      "automation"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": false,
      "cpu_limit": 50,
      "memory_limit": "256M"
    },
    "implementation_type": "cli",
    "cli_command": "python3 -c '{script}'",
    "dependencies": [
      "python3"
    ],
    "timeout": 60
