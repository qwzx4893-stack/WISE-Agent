[
  {
    "name": "apify-ultimate-scraper",
    "version": "1.0.0",
    "description": "Apify is a full-stack web scraping and browser automation platform. It provides pre-built actors for scraping, proxy rotation, headless browser control, and data extraction APIs for scalable web data collection.",
    "use_cases": [
      "Web scraping",
      "Data extraction",
      "Browser automation",
      "Proxy rotation",
      "Scalable crawling"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "Starting URL to scrape"
        },
        "actor": {
          "type": "string",
          "description": "Actor name (puppeteer/cheerio/playwright)",
          "default": "puppeteer"
        },
        "max_pages": {
          "type": "integer",
          "description": "Maximum pages to crawl",
          "default": 10
        }
      },
      "required": [
        "url"
      ]
    },
    "output_format": "Scraped data in JSON or structured format.",
    "capabilities": [
      "scraping",
      "crawling",
      "automation",
      "proxy",
      "data extraction",
      "headless"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true,
      "memory_limit": "512M"
    },
    "implementation_type": "cli",
    "cli_command": "apify run {actor} --input '{ \"startUrls\": [{\"url\": \"{url}\"}], \"maxPagesPerCrawl\": {max_pages} }'",
    "dependencies": [
      "apify-cli",
      "nodejs"
    ],
    "timeout": 600,
    "author": "Apify",
    "source": "https://github.com/apify/apify-client-js"
  },
  {
    "name": "tavily-web",
    "version": "1.0.0",
    "description": "Tavily is a search engine API built specifically for AI agents and LLMs. It delivers real-time, accurate, and factual search results optimized for retrieval-augmented generation (RAG) and agent workflows.",
    "use_cases": [
      "AI search API",
      "RAG search",
      "Factual information retrieval",
      "Agent web research",
      "Real-time search"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query"
        },
        "search_depth": {
          "type": "string",
          "description": "Search depth (basic/advanced)",
          "default": "basic"
        },
        "max_results": {
          "type": "integer",
          "description": "Maximum results",
          "default": 5
        },
        "include_answer": {
          "type": "boolean",
          "description": "Include AI-generated answer",
          "default": true
        }
      },
      "required": [
        "query"
      ]
    },
    "output_format": "Search results with titles, URLs, content snippets, and optional AI answer.",
    "capabilities": [
      "search",
      "RAG",
      "AI",
      "web",
      "real-time",
      "factual"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "python3 -c 'from tavily import TavilyClient; c = TavilyClient(); print(c.search(\"{query}\", search_depth=\"{search_depth}\", max_results={max_results}, include_answer={include_answer}))'",
    "dependencies": [
      "python3",
      "tavily-python"
    ],
    "timeout": 60,
    "author": "Tavily",
    "source": "https://github.com/tavily-ai/tavily-python"
  },
  {
    "name": "fal-platform",
    "version": "1.0.0",
    "description": "Fal is a serverless platform for running AI models at scale. It provides instant inference APIs for Flux, Stable Diffusion, LLMs, and custom models with sub-second cold starts and pay-per-use pricing.",
    "use_cases": [
      "AI model inference",
      "Image generation",
      "Video generation",
      "LLM hosting",
      "Serverless AI"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "description": "Model ID (flux/sd/llama/mistral)"
        },
        "prompt": {
          "type": "string",
          "description": "Input prompt"
        },
        "params": {
          "type": "string",
          "description": "Additional parameters JSON",
          "default": "{}"
        }
      },
      "required": [
        "model",
        "prompt"
      ]
    },
    "output_format": "Model inference result (image URL, text, JSON).",
    "capabilities": [
      "AI inference",
      "serverless",
      "image generation",
      "LLM",
      "flux",
      "stable diffusion"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "python3 -c 'import fal_client; result = fal_client.run(\"{model}\", arguments={{\"prompt\": \"{prompt}\"}}); print(result)'",
    "dependencies": [
      "python3",
      "fal-client"
    ],
    "timeout": 180,
    "author": "Fal",
    "source": "https://github.com/fal-ai/fal"
  },
  {
    "name": "elevenlabs",
    "version": "1.0.0",
    "description": "ElevenLabs is the industry-leading AI voice synthesis and text-to-speech platform. It provides ultra-realistic voice generation, voice cloning, and speech-to-speech conversion with support for 29+ languages.",
    "use_cases": [
      "Text-to-speech",
      "Voice synthesis",
      "Voice cloning",
      "Audiobook creation",
      "AI voiceover"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "Text to convert to speech"
        },
        "voice": {
          "type": "string",
          "description": "Voice ID or name",
          "default": "Rachel"
        },
        "model": {
          "type": "string",
          "description": "Model ID",
          "default": "eleven_multilingual_v2"
        }
      },
      "required": [
        "text"
      ]
    },
    "output_format": "Audio file URL or base64 encoded audio.",
    "capabilities": [
      "TTS",
      "voice",
      "speech",
      "audio",
      "cloning",
      "multilingual"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "python3 -c 'from elevenlabs import generate, play; audio = generate(text=\"{text}\", voice=\"{voice}\", model=\"{model}\"); print(audio)'",
    "dependencies": [
      "python3",
      "elevenlabs"
    ],
    "timeout": 120,
    "author": "ElevenLabs",
    "source": "https://github.com/elevenlabs/elevenlabs-python"
  },
  {
    "name": "stability-ai",
    "version": "1.0.0",
    "description": "Stability AI provides state-of-the-art generative AI models including Stable Diffusion for image generation, Stable Video Diffusion for video, and Stable Audio for music. The platform offers API access to all models.",
    "use_cases": [
      "AI image generation",
      "Text-to-image",
      "Image-to-image",
      "Video generation",
      "Audio generation"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "description": "Generation prompt"
        },
        "model": {
          "type": "string",
          "description": "Model (sd3/svd/stable-audio)",
          "default": "sd3"
        },
        "negative_prompt": {
          "type": "string",
          "description": "Negative prompt",
          "default": ""
        },
        "steps": {
          "type": "integer",
          "description": "Inference steps",
          "default": 30
        }
      },
      "required": [
        "prompt"
      ]
    },
    "output_format": "Generated image URL or base64 encoded media.",
    "capabilities": [
      "generative AI",
      "image",
      "video",
      "audio",
      "stable diffusion",
      "text-to-image"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "python3 -c 'import stability_sdk; print(stability_sdk.generate(\"{prompt}\", model=\"{model}\", steps={steps}))'",
    "dependencies": [
      "python3",
      "stability-sdk"
    ],
    "timeout": 180,
    "author": "Stability AI",
    "source": "https://github.com/Stability-AI/stability-sdk"
  },
