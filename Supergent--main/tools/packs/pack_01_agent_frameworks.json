  {
    "name": "vexor",
    "version": "1.0.0",
    "description": "Vexor is a vector-powered CLI for semantic file search over codebases. It indexes project files and enables finding files by meaning rather than exact text matches, ideal for AI coding assistants and autonomous agents.",
    "use_cases": [
      "Semantic file search",
      "Codebase exploration",
      "Finding files by description",
      "AI-assisted navigation"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Semantic search query describing what you're looking for"
        },
        "path": {
          "type": "string",
          "description": "Project path to search in",
          "default": "."
        },
        "top": {
          "type": "integer",
          "description": "Number of results",
          "default": 5
        }
      },
      "required": [
        "query"
      ]
    },
    "output_format": "Ranked list of file paths with similarity scores and previews.",
    "capabilities": [
      "semantic search",
      "vector search",
      "code navigation",
      "file discovery"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "vexor search '{query}' --path {path} --top {top}",
    "dependencies": [
      "vexor"
    ],
    "timeout": 60,
    "author": "scarletkc",
    "source": "https://github.com/scarletkc/vexor",
    "replaces": "1.0.0"
  },
