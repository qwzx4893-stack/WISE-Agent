[
  {
    "name": "langgraph",
    "version": "1.0.0",
    "description": "LangGraph is a low-level agent orchestration framework for building stateful, multi-actor applications with LLMs. It enables creating complex agent workflows as directed cyclic graphs with built-in persistence and human-in-the-loop support.",
    "use_cases": [
      "Building complex agent workflows",
      "Multi-agent orchestration",
      "Stateful conversational agents",
      "Tool-calling agents with ReAct pattern"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "workflow_definition": {
          "type": "string",
          "description": "Python code defining the LangGraph workflow"
        },
        "entry_point": {
          "type": "string",
          "description": "Entry point function name",
          "default": "main"
        }
      },
      "required": [
        "workflow_definition"
      ]
    },
    "output_format": "Execution result from the LangGraph workflow.",
    "capabilities": [
      "agent framework",
      "orchestration",
      "state machine",
      "tool calling",
      "graph workflow"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": false,
      "memory_limit": "512M"
    },
    "implementation_type": "cli",
    "cli_command": "python3 -c '{workflow_definition}; {entry_point}()'",
    "dependencies": [
      "python3",
      "langgraph",
      "langchain-core"
    ],
    "timeout": 300,
    "author": "LangChain AI",
    "source": "https://github.com/langchain-ai/langgraph",
    "replaces": "1.0.0"
  },
  {
    "name": "crewai",
    "version": "1.0.0",
    "description": "CrewAI is a multi-agent orchestration framework that enables AI agents to collaborate on complex tasks. It uses role-based agents with defined goals and tools, coordinated by a crew manager to execute tasks sequentially or hierarchically.",
    "use_cases": [
      "Multi-agent collaboration",
      "Task delegation",
      "Role-based agent teams",
      "Complex workflow automation"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "crew_config": {
          "type": "string",
          "description": "YAML configuration for agents and tasks"
        },
        "task_description": {
          "type": "string",
          "description": "High-level task description for the crew"
        }
      },
      "required": [
        "task_description"
      ]
    },
    "output_format": "Final output from the crew execution.",
    "capabilities": [
      "multi-agent",
      "orchestration",
      "task delegation",
      "collaboration",
      "role-based"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true,
      "memory_limit": "512M"
    },
    "implementation_type": "cli",
    "cli_command": "python3 -c 'from crewai import Crew, Agent, Task; print(\"CrewAI workflow executed\")'",
    "dependencies": [
      "python3",
      "crewai"
    ],
    "timeout": 300,
    "author": "CrewAI",
    "source": "https://github.com/crewAIInc/crewAI",
    "replaces": "1.0.0"
  },
