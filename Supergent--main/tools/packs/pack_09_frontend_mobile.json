  {
    "name": "django-pro",
    "version": "1.0.0",
    "description": "Django Pro is an expert agent for Django web framework development. It provides production-ready code generation, ORM optimization, security best practices, deployment configurations, and comprehensive Django knowledge.",
    "use_cases": [
      "Django development",
      "ORM optimization",
      "API development with DRF",
      "Django security hardening",
      "Production deployment"
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "description": "Django development task description"
        },
        "action": {
          "type": "string",
          "description": "Action (generate/optimize/review/deploy)",
          "default": "generate"
        }
      },
      "required": [
        "task"
      ]
    },
    "output_format": "Generated Django code, configuration, or recommendations.",
    "capabilities": [
      "django",
      "python",
      "web framework",
      "ORM",
      "API",
      "DRF",
      "production",
      "security"
    ],
    "category": "Execution",
    "security": {
      "requires_sandbox": true,
      "requires_network": true
    },
    "implementation_type": "cli",
    "cli_command": "python3 -c 'import django; print(django.get_version())' && django-admin {action} '{task}'",
    "dependencies": [
      "python3",
      "django"
    ],
    "timeout": 300,
    "author": "Django",
    "source": "https://github.com/django/django"
  },
